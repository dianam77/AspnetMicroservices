@page
@model AspnetRunBasics.CheckOutModel
@{
    ViewData["Title"] = "CheckOut";
}

<div class="container">
    <div class="row">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-page="Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-page="Cart">Cart</a></li>
                    <li class="breadcrumb-item active" aria-current="page">CheckOut</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="container">
    <div class="row">

        <!-- Sidebar cart -->
        <div class="col-md-4 order-md-2 mb-4">
            <h4 class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted">Your cart</span>
                <span class="badge badge-secondary badge-pill">@Model.Cart.Items.Count</span>
            </h4>

            <ul class="list-group mb-3">
                @foreach (var item in Model.Cart.Items)
                {
                    <li class="list-group-item d-flex justify-content-between lh-condensed">
                        <div>
                            <h6 class="my-0">@item.ProductName</h6>
                            <small class="text-muted">@item.ProductName</small>
                        </div>
                        <span class="text-muted">$@item.Price</span>
                    </li>
                }
                <li class="list-group-item d-flex justify-content-between">
                    <span>Total (USD)</span>
                    <strong>$@Model.Cart.TotalPrice</strong>
                </li>
            </ul>

            <form class="card p-2">
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="Promo code" />
                    <div class="input-group-append">
                        <button type="submit" class="btn btn-secondary">Redeem</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Checkout form -->
        <div class="col-md-8 order-md-1">
            <h4 class="mb-3">Billing address</h4>

            <form method="post" asp-page-handler="CheckOut">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Order.FirstName"></label>
                        <input asp-for="Order.FirstName" class="form-control" id="firstName" required />
                        <span asp-validation-for="Order.FirstName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Order.LastName"></label>
                        <input asp-for="Order.LastName" class="form-control" id="lastName" required />
                        <span asp-validation-for="Order.LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Order.UserName"></label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text">@@</span>
                        </div>
                        <input asp-for="Order.UserName" class="form-control" id="username" required />
                    </div>
                    <span asp-validation-for="Order.UserName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Order.EmailAddress">Email <span class="text-muted">(Optional)</span></label>
                    <input asp-for="Order.EmailAddress" type="email" class="form-control" id="email" placeholder="you@example.com" />
                    <span asp-validation-for="Order.EmailAddress" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Order.AddressLine"></label>
                    <input asp-for="Order.AddressLine" class="form-control" id="address" placeholder="1234 Main St" required />
                    <span asp-validation-for="Order.AddressLine" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="address2">Address 2 <span class="text-muted">(Optional)</span></label>
                    <input type="text" class="form-control" id="address2" placeholder="Apartment or suite" />
                </div>

                <div class="row">
                    <div class="col-md-5 mb-3">
                        <label asp-for="Order.Country"></label>
                        <select asp-for="Order.Country" class="custom-select d-block w-100" id="country" required>
                            <option value="">Choose...</option>
                            <option>United States</option>
                        </select>
                        <span asp-validation-for="Order.Country" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Order.State"></label>
                        <select asp-for="Order.State" class="custom-select d-block w-100" id="state" required>
                            <option value="">Choose...</option>
                            <option>California</option>
                        </select>
                        <span asp-validation-for="Order.State" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="Order.ZipCode"></label>
                        <input asp-for="Order.ZipCode" class="form-control" id="zip" required />
                        <span asp-validation-for="Order.ZipCode" class="text-danger"></span>
                    </div>
                </div>

                <hr class="mb-4" />

                <div class="custom-control custom-checkbox mb-2">
                    <input type="checkbox" class="custom-control-input" id="same-address" />
                    <label class="custom-control-label" for="same-address">Shipping address is the same as my billing address</label>
                </div>

                <div class="custom-control custom-checkbox mb-4">
                    <input type="checkbox" class="custom-control-input" id="save-info" />
                    <label class="custom-control-label" for="save-info">Save this information for next time</label>
                </div>

                <hr class="mb-4" />

                <h4 class="mb-3">Payment</h4>

                <div class="d-block my-3">
                    <div class="custom-control custom-radio">
                        <input asp-for="Order.PaymentMethod" class="custom-control-input" id="credit" type="radio" value="CreditCard" />
                        <label class="custom-control-label" for="credit">Credit card</label>
                    </div>

                    <div class="custom-control custom-radio">
                        <input asp-for="Order.PaymentMethod" class="custom-control-input" id="debit" type="radio" value="DebitCard" />
                        <label class="custom-control-label" for="debit">Debit card</label>
                    </div>

                    <div class="custom-control custom-radio">
                        <input asp-for="Order.PaymentMethod" class="custom-control-input" id="paypal" type="radio" value="Paypal" />
                        <label class="custom-control-label" for="paypal">Paypal</label>
                    </div>
                    <span asp-validation-for="Order.PaymentMethod" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Order.CardName"></label>
                        <input asp-for="Order.CardName" class="form-control" id="cc-name" required />
                        <small class="text-muted">Full name as displayed on card</small>
                        <span asp-validation-for="Order.CardName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Order.CardNumber"></label>
                        <input asp-for="Order.CardNumber" class="form-control" id="cc-number" required />
                        <span asp-validation-for="Order.CardNumber" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label asp-for="Order.Expiration"></label>
                        <input asp-for="Order.Expiration" class="form-control" id="cc-expiration" required />
                        <span asp-validation-for="Order.Expiration" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="Order.CVV"></label>
                        <input asp-for="Order.CVV" class="form-control" id="cc-cvv" required />
                        <span asp-validation-for="Order.CVV" class="text-danger"></span>
                    </div>
                </div>

                <hr class="mb-4" />

                <button class="btn btn-primary btn-lg btn-block" type="submit">Checkout Order</button>
            </form>
        </div>
    </div>
</div>
