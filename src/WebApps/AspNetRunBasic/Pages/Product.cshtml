@page
@model AspnetRunBasics.ProductModel
@{
    ViewData["Title"] = "Product";
}

<div class="container">
    <div class="row">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-page="Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-page="Product">Category</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.SelectedCategory</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="container">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-12 col-sm-3">
            <!-- Categories -->
            <div class="card bg-light mb-3">
                <div class="card-header bg-primary text-white text-uppercase">
                    <i class="fa fa-list"></i> Categories
                </div>
                <ul class="list-group category_block">
                    @foreach (var category in Model.CategoryList)
                    {
                        <li class="list-group-item @(category == Model.SelectedCategory ? "active" : "")">
                            <a asp-page="Product" asp-route-categoryName="@category" class="@(category == Model.SelectedCategory ? "text-white" : "")">@category</a>
                        </li>
                    }
                </ul>
            </div>

            <!-- Last Product -->
            <div class="card bg-light mb-3">
                <div class="card-header bg-success text-white text-uppercase">Last product</div>
                <div class="card-body">
                    @{
                        var lastProduct = Model.ProductList.LastOrDefault();
                    }
                    @if (lastProduct != null)
                    {
                        <a asp-page="/ProductDetail" asp-route-productId="@lastProduct.Id">
                            <img asp-append-version="true" class="img-fluid mb-2" src="~/images/product/@lastProduct.ImageFile" />
                        </a>
                        <h5 class="card-title">@lastProduct.Name</h5>
                        <p class="card-text">@lastProduct.Summary</p>
                        <p class="bloc_left_price">@lastProduct.Price $</p>
                    }
                    else
                    {
                        <p>No products available.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col">
            <div class="row">
                @if (Model.ProductList.Any())
                {
                    @foreach (var product in Model.ProductList)
                    {
                        <div class="col-sm">
                            <partial name="_ProductItemPartial" model="@product" />
                        </div>
                    }

                }
                else
                {
                    <div class="col-12">
                        <div class="alert alert-info">No products found in this category.</div>
                    </div>
                }

                <!-- Pagination Placeholder (Optional: implement real pagination logic) -->
                <div class="col-12">
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            <li class="page-item disabled">
                                <span class="page-link">Previous</span>
                            </li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#">3</a></li>
                            <li class="page-item">
                                <a class="page-link" href="#">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>
